# ============================================================
# MondoGioco — Variabili d'ambiente
# ============================================================
# Copia questo file in .env.local e inserisci i valori reali.

# Supabase — trovi queste credenziali nel tuo progetto su https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# URL dell'applicazione (usato per callback OAuth e link)
NEXT_PUBLIC_APP_URL=http://localhost:3000
