# ============================================================
# MondoGioco — variabili d'ambiente Supabase (esempio)
# ============================================================
# Copia questo file in `.env.local` e inserisci i valori del TUO progetto.
# `.env.local` è ignorato da Git e non deve mai essere committato.
#
# Dove trovarli: dashboard Supabase → Project Settings → API
#   - Project URL            -> NEXT_PUBLIC_SUPABASE_URL
#   - anon / publishable key -> NEXT_PUBLIC_SUPABASE_ANON_KEY
#
# La anon key è PUBBLICA per design (protegge tramite Row Level Security).
# NON inserire qui la service_role key: bypassa RLS e va usata solo in script
# amministrativi lato server, mai in variabili NEXT_PUBLIC_*.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# (Opzionale) usata SOLO da script locali di amministrazione, mai dal client.
# Lasciarla vuota se non serve.
SUPABASE_SERVICE_ROLE_KEY=
